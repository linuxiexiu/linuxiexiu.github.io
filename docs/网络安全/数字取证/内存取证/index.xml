&lt;h3 id="内存取证核心概念"&gt;内存取证核心概念&lt;a class="anchor" href="#%e5%86%85%e5%ad%98%e5%8f%96%e8%af%81%e6%a0%b8%e5%bf%83%e6%a6%82%e5%bf%b5"&gt;#&lt;/a&gt;&lt;/h3&gt;
