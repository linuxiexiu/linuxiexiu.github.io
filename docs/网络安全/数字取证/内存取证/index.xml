&lt;h3 id="内存取证技术体系"&gt;内存取证技术体系&lt;a class="anchor" href="#%e5%86%85%e5%ad%98%e5%8f%96%e8%af%81%e6%8a%80%e6%9c%af%e4%bd%93%e7%b3%bb"&gt;#&lt;/a&gt;&lt;/h3&gt;
&lt;ul&gt;
